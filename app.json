{
  "expo": {
    "name": "Study Desk",
    "slug": "study-desk",
    "version": "3.3.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#2f6f62"
    },
    "plugins": [
      [
        "expo-calendar",
        {
          "calendarPermission": "Study Desk adds your deadlines and exams to your calendar."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#2f6f62"
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Unlock Study Desk with Face ID."
        }
      ],
      "expo-secure-store"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.yourname.studydesk"
    },
    "android": {
      "package": "com.yourname.studydesk",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#2f6f62"
      },
      "permissions": [
        "READ_CALENDAR",
        "WRITE_CALENDAR",
        "USE_BIOMETRIC",
        "USE_FINGERPRINT"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "scheme": "studydesk"
  }
}